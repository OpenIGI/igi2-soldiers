<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The SDK a mod is built with comes from nuget.org once released; until then from sdk-packages/ (see its README). -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="openigi-sdk" value="sdk-packages" />
  </packageSources>
</configuration>
