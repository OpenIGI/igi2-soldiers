<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\mods\OpenIGI.Mods.Igi2Soldiers\OpenIGI.Mods.Igi2Soldiers.csproj" />
    <ProjectReference Include="..\OpenIGI.TestSupport\OpenIGI.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Engine\OpenIGI.Modding.Loader\OpenIGI.Modding.Loader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- The mod's package, as the launcher installs it, beside the tests. -->
  <Target Name="CopyModPackage" AfterTargets="Build">
    <MSBuild Projects="..\..\mods\OpenIGI.Mods.Igi2Soldiers\OpenIGI.Mods.Igi2Soldiers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ModAssembly" />
    </MSBuild>
    <PropertyGroup>
      <ModPackageSource>@(ModAssembly->'%(RootDir)%(Directory)mod\')</ModPackageSource>
    </PropertyGroup>
    <ItemGroup>
      <ModPackage Include="$(ModPackageSource)**" />
    </ItemGroup>
    <Copy SourceFiles="@(ModPackage)" DestinationFolder="$(OutDir)Igi2SoldiersPackage\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
