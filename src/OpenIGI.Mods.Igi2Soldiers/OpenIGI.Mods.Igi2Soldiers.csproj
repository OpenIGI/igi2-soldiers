<Project Sdk="OpenIGI.Modding.Sdk">

  <!-- A mod: Project I.G.I.'s missions spawn I.G.I. 2's soldiers, which run I.G.I. 2's AI. Its mod.json is written from these. -->
  <PropertyGroup>
    <AssemblyName>OpenIGI.Mods.Igi2Soldiers</AssemblyName>
    <RootNamespace>OpenIGI.Mods.Igi2Soldiers</RootNamespace>
    <ModId>igi2soldiers</ModId>
    <ModName>I.G.I. 2 soldiers</ModName>
    <Version>0.2.0</Version>
    <ModSummary>Project I.G.I.'s missions guarded by I.G.I. 2's soldiers: their bodies, weapons and AI.</ModSummary>
    <Authors>OpenIGI</Authors>
    <ModTitles>igi1</ModTitles>
    <ModRequiresTitleData>igi2</ModRequiresTitleData>
    <!-- Not finished: the launcher marks it EXPERIMENTAL. The first game with a mod loader is 0.5.0. -->
    <ModExperimental>true</ModExperimental>
    <ModMinGameVersion>0.5.0</ModMinGameVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Mapping\igi2soldiers.json" LogicalName="igi2soldiers.json" />
    <InternalsVisibleTo Include="OpenIGI.Mods.Igi2Soldiers.Tests" />
  </ItemGroup>

</Project>
